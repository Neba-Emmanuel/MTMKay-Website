Options -MultiViews
RewriteEngine On

AddType application/javascript js mjs
AddType text/css css

<FilesMatch "\.js$">
  ForceType application/javascript
</FilesMatch>

<FilesMatch "\.mjs$">
  ForceType application/javascript
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]